{
    "name": "BC on Linux",
    "image": "mcr.microsoft.com/devcontainers/dotnet:8.0",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/devcontainers/features/sshd:1": {}
    },
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb",
        "storage": "32gb"
    },
    "forwardPorts": [7048, 7049, 7052, 8080],
    "portsAttributes": {
        "7048": { "label": "BC OData" },
        "7049": { "label": "BC dev endpoint (F5)" },
        "7052": { "label": "BC API" },
        "8080": { "label": "BC web client" }
    },
    "postCreateCommand": "BC_WEBCLIENT=1 BC_WEBCLIENT_TRUST_FORWARDED_HEADERS=1 BC_WEBCLIENT_PUBLIC_URL=${CODESPACE_NAME:+https://${CODESPACE_NAME}-8080.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}/} docker compose up -d --wait",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dynamics-smb.al"
            ]
        }
    }
}
